# Server listener
HOST=127.0.0.1
PORT=3000

# Project metadata
PROJECT_VERSION=0.1.0-local
SOURCE_REPOSITORY_URL=https://github.com/BaizhouziYou/xintinglei-website

# Status storage and Minecraft polling
STATUS_DATABASE_PATH=./data/status.db
MC_SERVER_ADDRESS=mc.xintinglei.cn
MC_SERVER_PORT=25565
MC_ENABLE_SRV=true
STATUS_POLL_TIMEOUT_MS=5000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Keep this false unless you have a clear privacy policy for player names.
SHOW_PLAYER_NAMES=false
